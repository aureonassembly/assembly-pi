{
  "name": "assembly-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal-first voice UI around the pi coding agent",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
